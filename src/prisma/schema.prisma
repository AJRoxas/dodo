generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assessments {
  id               Int         @id @default(autoincrement())
  course_id        Int
  category_id      Int?
  name             String      @unique @db.VarChar(100)
  points_earned    Float       @db.Real
  potential_points Float       @db.Real
  weight           Float       @db.Real
  completed_date   DateTime    @db.Date
  categories       categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  courses          courses     @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([course_id, name], map: "uq_assessments_course_name")
}

model categories {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(50)
  assessments assessments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model courses {
  id           Int           @id @default(autoincrement())
  user_id      String        @db.VarChar(28)
  course_code  String        @unique @db.VarChar(20)
  weight       Float         @db.Real
  goal_grade   Int
  is_pass_fail Boolean
  year         Int
  assessments  assessments[]
  users        users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coursetags   coursetags[]
}

model coursetags {
  course_id Int
  tag_id    Int
  courses   courses @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags      tags    @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([course_id, tag_id])
}

model tags {
  id         Int          @id @default(autoincrement())
  name       String       @unique @db.VarChar(50)
  coursetags coursetags[]
}

model users {
  id           String        @id @db.VarChar(28)
  email        String?       @unique @db.VarChar(255)
  is_anon      Boolean       @default(false)
  courses      courses[]
  usersettings usersettings?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usersettings {
  user_id          String @id @db.VarChar(28)
  initial_credits  Float  @db.Real
  initial_gpa      Float  @db.Real
  required_credits Float  @db.Real
  final_gpa_goal   Float  @db.Real
  gpa_scale        Json   @default("[]")
  users            users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
